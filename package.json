{
  "name": "opencode-footprint",
  "version": "0.0.0",
  "description": "A lightweight, readable footprint of what your OpenCode agent actually did — files touched, commands run, network access.",
  "license": "MIT",
  "author": "Marcen1603",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Marcen1603/opencode-footprint.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "ai-agent",
    "coding-agent",
    "observability",
    "session-tracking",
    "cli",
    "tui"
  ],
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./tui": {
      "types": "./src/tui.tsx",
      "import": "./src/tui.tsx"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    }
  },
  "bin": {
    "opencode-footprint": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src/tui.tsx",
    "src/sidebar.ts",
    "src/report.ts",
    "src/schema.ts",
    "src/store.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0",
    "@opencode/theme": ">=2.0.0",
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@opencode/plugin": "2.0.26",
    "@opencode/theme": "2.2.2",
    "@opentui/core": "^0.6.6",
    "@opentui/solid": "^0.6.6",
    "@types/bun": "1.4.2",
    "@types/node": "^26.6.5",
    "solid-js": "^1.9.17",
    "typescript": "^7.0.2"
  },
  "peerDependenciesMeta": {
    "@opencode/theme": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  }
}
